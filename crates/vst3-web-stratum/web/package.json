    "./vue": "./vue/index.js",
    "./vue/*": "./vue/*"
  },
  "files": [
    "vst3-web-stratum.js",
    "components/",
    "vue/"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "vue": {
